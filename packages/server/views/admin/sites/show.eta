<%/* admin/sites/show.eta — Vue détail complète d'un site */%>
<%
function fmtYear(y) {
  if (y == null) return '—';
  return y < 0 ? Math.abs(y) + ' BC' : y + ' AD';
}
function fmtDate(d) {
  if (!d) return '—';
  return new Date(d).toLocaleString('fr-FR');
}
function wdLink(qid) {
  return '<a href="https://www.wikidata.org/wiki/' + qid + '" target="_blank" class="wd-id">' + qid + '</a>';
}
function toDisplayStr(v) {
  if (v == null) return '—';
  if (typeof v === 'string') return v;
  if (typeof v === 'number') return v.toLocaleString();
  if (typeof v === 'object') {
    if (v.name) return v.name + (v.wikidata ? ' ' + wdLink(v.wikidata) : ' <span class="no-qid">no QID</span>');
    if (v.text) return v.text + (v.lang ? ' <span class="wd-id">(' + v.lang + ')</span>' : '');
  }
  return String(v);
}
const tl = it.site.timeline;
const names = it.site.names || {};
const meta  = it.site.meta  || {};

// Tracks in narrative order. religion + language are the V2 additions.
const TRACK_KEYS = ['site_type','polity','culture','religion','language','name','population'];

// These two carry a `role` qualifier (state / major / minor / minority).
const ROLE_TRACKS = ['religion','language'];

// These four carry a {name, wikidata} value — the QID is editable via the modal.
const QID_TRACKS = ['polity','culture','religion','language'];

// Best-effort display name for an entry, used as the staleness guard (must match
// the server's entryName()).
function entryDisplayName(e) {
  var v = e && e.value;
  if (v == null) return '';
  if (typeof v === 'string') return v;
  if (typeof v === 'number') return String(v);
  if (typeof v === 'object') return v.name || v.text || '';
  return String(v);
}

const missing = Array.isArray(tl && tl.missing_entities) ? tl.missing_entities : [];
%>

<div class="page-header">
  <a href="/admin/sites" class="back-link">← Sites</a>
  <h1><%= it.site.title_en %></h1>
  <div class="badge-group">
    <span class="badge"><%= it.site.id %></span>
    <% if (it.site.wikidata_id) { %>
      <a href="https://www.wikidata.org/wiki/<%= it.site.wikidata_id %>" target="_blank" class="badge badge--info"><%= it.site.wikidata_id %> ↗</a>
    <% } %>
    <% if (it.site.enrichment_level) { %>
      <span class="badge badge--level badge--<%= it.site.enrichment_level %>"><%= it.site.enrichment_level %></span>
    <% } %>
  </div>
</div>

<div class="action-bar">
  <a href="/admin/extract/<%= it.site.id %>" class="btn btn-primary">🤖 Extraction LLM</a>
  <% if (it.site.wikipedia_page_en_url) { %>
    <a href="<%= it.site.wikipedia_page_en_url %>" target="_blank" class="btn btn-ghost">Wikipedia ↗</a>
  <% } %>
  <% if (it.site.wikidata_id) { %>
    <a href="https://www.wikidata.org/wiki/<%= it.site.wikidata_id %>" target="_blank" class="btn btn-ghost">Wikidata ↗</a>
  <% } %>
</div>

<!-- ── Métadonnées ── -->
<div class="section-block">
  <h2 class="section-title">Métadonnées</h2>
  <div class="detail-grid-3">
    <div class="detail-card">
      <h3>Identification</h3>
      <dl class="detail-dl">
        <dt>ID</dt>         <dd><code><%= it.site.id %></code></dd>
        <dt>Source</dt>     <dd><%= it.site.source || '—' %></dd>
        <dt>Mis à jour</dt> <dd><%= fmtDate(it.site.last_updated) %></dd>
        <dt>Sitelinks</dt>  <dd><%= it.site.sitelinks_count != null ? it.site.sitelinks_count : '—' %></dd>
        <dt>Importance</dt> <dd><span class="importance-badge"><%= it.site.base_importance %></span></dd>
      </dl>
    </div>
    <div class="detail-card">
      <h3>Géographie</h3>
      <dl class="detail-dl">
        <dt>Pays</dt>     <dd><%= it.site.country_name || it.site.country || '—' %></dd>
        <dt>QID pays</dt>
        <dd>
          <% if (it.site.country_qid) { %>
            <%~ wdLink(it.site.country_qid) %>
          <% } else { %>—<% } %>
        </dd>
        <dt>Coords</dt>
        <dd>
          <% if (it.site.lat) { %>
            <code><%= Number(it.site.lat).toFixed(5) %>, <%= Number(it.site.lon).toFixed(5) %></code>
            <a href="https://www.openstreetmap.org/?mlat=<%= it.site.lat %>&mlon=<%= it.site.lon %>&zoom=12" target="_blank" class="link-small">OSM ↗</a>
          <% } else { %><span class="text-warn">Manquantes</span><% } %>
        </dd>
      </dl>
    </div>
    <div class="detail-card">
      <h3>Temporel</h3>
      <dl class="detail-dl">
        <dt>Inception (BDD)</dt>   <dd><%= fmtYear(it.site.inception_year) %></dd>
        <dt>Dissolution (BDD)</dt> <dd><%= fmtYear(it.site.dissolution_year) %></dd>
        <dt>Population</dt>        <dd><%= it.site.population != null ? Number(it.site.population).toLocaleString() : '—' %></dd>
      </dl>
    </div>
  </div>
</div>

<!-- ── Noms ── -->
<% if (Object.keys(names).length || meta.native_label) { %>
<div class="section-block">
  <h2 class="section-title">Noms multilingues</h2>
  <div class="detail-card">
    <div class="names-grid">
      <% Object.entries(names).forEach(function(entry) { var lang = entry[0]; var name = entry[1]; %>
        <div class="name-entry">
          <span class="name-lang"><%= lang %></span>
          <span class="name-val"><%= name %></span>
        </div>
      <% }); %>
      <% if (meta.native_label) { %>
        <div class="name-entry">
          <span class="name-lang">native</span>
          <span class="name-val"><%= meta.native_label %></span>
        </div>
      <% } %>
    </div>
  </div>
</div>
<% } %>

<!-- ── Enrichissement ── -->
<div class="section-block">
  <h2 class="section-title">Enrichissement</h2>
  <div class="detail-grid">
    <div class="detail-card">
      <h3>Wikidata</h3>
      <dl class="detail-dl">
        <dt>Enrichi le</dt>  <dd><%= fmtDate(it.site.wikidata_enriched_at) %></dd>
        <dt>Description</dt> <dd class="text-muted"><%= meta.description || meta.wikidata_description || '—' %></dd>
      </dl>
    </div>
    <div class="detail-card">
      <h3>Timeline LLM</h3>
      <% if (tl) { %>
        <dl class="detail-dl">
          <dt>Extraite le</dt> <dd><%= fmtDate(it.site.timeline_extracted_at) %></dd>
          <dt>Modèle</dt>      <dd><code><%= it.site.timeline_extraction_model || '—' %></code></dd>
          <dt>Pistes</dt>
          <dd>
            <% TRACK_KEYS.forEach(function(k) { if (tl[k] && tl[k].entries && tl[k].entries.length) { %><span class="tag tag--<%= k %>"><%= k %>: <%= tl[k].entries.length %></span><% } }); %>
            <% if (Array.isArray(tl.events) && tl.events.length) { %><span class="tag">events: <%= tl.events.length %></span><% } %>
          </dd>
        </dl>
      <% } else { %>
        <div class="timeline-status missing">⚠️ Aucune timeline extraite</div>
      <% } %>
    </div>
  </div>
</div>

<!-- ── Entités manquantes signalées ── -->
<% if (missing.length) { %>
<div class="section-block">
  <h2 class="section-title">Entités signalées comme manquantes <span class="text-muted">(<%= missing.length %>)</span></h2>
  <div class="detail-card">
    <table class="data-table data-table--compact">
      <thead><tr><th>Piste</th><th>Nom</th><th>QID proposé</th><th>Contexte</th></tr></thead>
      <tbody>
        <% missing.forEach(function(m) { %>
        <tr>
          <td><span class="tag tag--<%= m.kind %>"><%= m.kind %></span></td>
          <td><%= m.name %></td>
          <td>
            <% var pq = m.proposed_qid || m.wikidata || m.qid; %>
            <% if (pq && /^Q\d+$/.test(pq)) { %><%~ wdLink(pq) %><% } else { %>—<% } %>
          </td>
          <td class="text-muted cell-notes"><%= m.context || '' %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <p class="hint">→ <a href="/admin/gaps">Referential gaps</a> pour les résoudre</p>
  </div>
</div>
<% } %>

<!-- ── Timeline détaillée ── -->
<% if (tl) { %>
<div class="section-block">
  <h2 class="section-title">Timeline détaillée</h2>

  <% for (var ki = 0; ki < TRACK_KEYS.length; ki++) {
    var trackKey = TRACK_KEYS[ki];
    var track = tl[trackKey];
    var isRef = QID_TRACKS.indexOf(trackKey) !== -1;
    var entries = (track && Array.isArray(track.entries)) ? track.entries : [];
    if (!entries.length && !isRef) continue;
    var hasRole = ROLE_TRACKS.indexOf(trackKey) !== -1;
  %>
  <div class="track-block">
    <h3 class="track-title track-title--<%= trackKey %>">
      <%= trackKey.toUpperCase() %>
      <span class="text-muted">(<%= entries.length %> entrées)</span>
      <% if (isRef) { %><button type="button" class="add-entry" data-track="<%= trackKey %>" title="Ajouter une entrée manuellement">+ Ajouter</button><% } %>
    </h3>
    <% if (entries.length) { %>
    <table class="data-table data-table--compact">
      <thead>
        <tr>
          <th>From</th>
          <% if (trackKey === 'site_type') { %><th>To</th><% } %>
          <th>Valeur</th>
          <% if (hasRole) { %><th>Rôle</th><% } %>
          <th>Confiance</th>
          <th>Notes</th>
          <th class="col-act"></th>
        </tr>
      </thead>
      <tbody>
        <% for (var ei = 0; ei < entries.length; ei++) { var e = entries[ei]; %>
        <tr>
          <td><code><%= fmtYear(e.from) %><%= e.from_circa ? ' ~' : '' %></code><% if (trackKey !== 'site_type' && e.to != null) { %> <code class="hiatus">→ <%= fmtYear(e.to) %></code><% } %></td>
          <% if (trackKey === 'site_type') { %>
            <td><% if (e.to != null) { %><code class="hiatus"><%= fmtYear(e.to) %></code><% } else { %>—<% } %></td>
          <% } %>
          <td>
            <% if (QID_TRACKS.indexOf(trackKey) !== -1 && e.value && typeof e.value === 'object' && e.value.name) { %>
              <span class="qid-edit<%= e.value.wikidata ? '' : ' qid-edit--empty' %>"
                    data-track="<%= trackKey %>" data-index="<%= ei %>"
                    data-name="<%= e.value.name %>" data-qid="<%= e.value.wikidata || '' %>"
                    data-notes="<%= e.notes || '' %>"
                    data-from="<%= e.from != null ? e.from : '' %>"
                    data-to="<%= e.to != null ? e.to : '' %>"
                    data-fromprec="<%= e.from_precision != null ? e.from_precision : '' %>"
                    data-fromcirca="<%= e.from_circa ? '1' : '' %>"
                    data-role="<%= e.role || '' %>"
                    title="Cliquer pour éditer l'entrée"><%= e.value.name %><% if (e.value.wikidata) { %> <span class="wd-id"><%= e.value.wikidata %></span><% } else { %> <span class="no-qid">no QID</span><% } %></span>
            <% } else { %>
              <%~ toDisplayStr(e.value) %>
            <% } %>
          </td>
          <% if (hasRole) { %>
            <td>
              <% if (e.role) { %>
                <span class="role-badge role-badge--<%= e.role %>"><%= e.role %></span>
              <% } else { %>—<% } %>
            </td>
          <% } %>
          <td>
            <% if (e.confidence) { %>
              <span class="conf-badge conf-badge--<%= e.confidence %>"><%= e.confidence %></span>
            <% } else { %>—<% } %>
          </td>
          <td class="text-muted cell-notes"><%= e.notes || '' %></td>
          <td class="col-act">
            <button type="button" class="entry-del" title="Supprimer cette entrée"
                    data-track="<%= trackKey %>" data-index="<%= ei %>"
                    data-name="<%= entryDisplayName(e) %>">✕</button>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
    <% } else { %>
      <p class="track-empty text-muted">Aucune entrée. Utilisez « + Ajouter ».</p>
    <% } %>
  </div>
  <% } %>

  <% if (Array.isArray(tl.events) && tl.events.length) { %>
  <div class="track-block">
    <h3 class="track-title">EVENTS <span class="text-muted">(<%= tl.events.length %> événements)</span></h3>
    <table class="data-table data-table--compact">
      <thead><tr><th>Année</th><th>Type</th><th>Cause</th><th>Auteur</th><th>Description</th><th class="col-act"></th></tr></thead>
      <tbody>
        <% for (var evi = 0; evi < tl.events.length; evi++) { var ev = tl.events[evi]; %>
        <tr>
          <td><code><%= fmtYear(ev.year) %></code></td>
          <td><span class="tag"><%= ev.type %></span></td>
          <td class="text-muted"><%= ev.cause || '—' %></td>
          <td>
            <%= ev.perpetrator || '—' %>
            <% if (ev.perpetrator_wikidata) { %>
              <%~ wdLink(ev.perpetrator_wikidata) %>
            <% } %>
          </td>
          <td class="text-muted cell-notes"><%= ev.description || '' %></td>
          <td class="col-act">
            <button type="button" class="entry-del" title="Supprimer cet événement"
                    data-track="events" data-index="<%= evi %>"
                    data-name="<%= ev.type || '' %>">✕</button>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<% } %>

<!-- ── JSON brut ── -->
<div class="section-block">
  <h2 class="section-title" style="cursor:pointer" onclick="toggleJson()">
    JSON brut <span id="json-toggle-icon">▶</span>
  </h2>
  <div id="json-raw" style="display:none">
    <pre class="json-pre"><%= JSON.stringify(it.site, function(k, v) { return typeof v === 'bigint' ? v.toString() : v; }, 2) %></pre>
  </div>
</div>

<!-- ── QID edit modal ── -->
<div id="qid-modal" class="modal-overlay" hidden>
  <div class="modal" role="dialog" aria-modal="true">
    <div class="modal-head">
      <span id="qid-modal-title">Attribuer un QID</span>
      <button type="button" class="modal-close" id="qid-modal-close" title="Fermer">✕</button>
    </div>
    <div class="modal-body">
      <div id="qid-modal-context" class="modal-context"></div>

      <label class="modal-label">Libellé de l'entrée</label>
      <div class="lbl-row">
        <input type="text" id="qid-label-input" class="modal-input" autocomplete="off" />
        <button type="button" id="qid-label-use" class="lbl-use" hidden></button>
      </div>

      <label class="modal-label">Rechercher un QID — nos entities</label>
      <input type="text" id="qid-search-ours" class="modal-input" placeholder="ex. Levantine Chalcolithic…" autocomplete="off" />
      <div id="qid-results-ours" class="modal-results"></div>

      <label class="modal-label">Rechercher un QID — Wikidata</label>
      <input type="text" id="qid-search-wd" class="modal-input" placeholder="ex. Early Bronze Age…" autocomplete="off" />
      <div id="qid-results-wd" class="modal-results"></div>

      <div class="modal-selected" id="qid-selected" hidden>Sélectionné : <span id="qid-selected-val"></span></div>

      <div class="date-grid">
        <div>
          <label class="modal-label">Début (négatif = BC)</label>
          <div class="date-row">
            <input type="number" id="qid-from" class="modal-input date-year" step="1" placeholder="année" />
            <select id="qid-from-prec" class="modal-input date-prec" title="Précision">
              <option value="9">année</option>
              <option value="8">décennie</option>
              <option value="7">siècle</option>
              <option value="6">millénaire</option>
            </select>
            <label class="date-circa" title="approximatif"><input type="checkbox" id="qid-from-circa" /> ~</label>
          </div>
        </div>
        <div>
          <label class="modal-label">Fin (optionnel)</label>
          <input type="number" id="qid-to" class="modal-input date-year" step="1" placeholder="—" />
        </div>
      </div>

      <div id="qid-role-wrap" hidden>
        <label class="modal-label">Rôle</label>
        <select id="qid-role" class="modal-input">
          <option value="">—</option>
          <option value="state">state</option>
          <option value="major">major</option>
          <option value="minor">minor</option>
          <option value="minority">minority</option>
        </select>
      </div>

      <label class="modal-label">Note</label>
      <textarea id="qid-note-input" class="modal-input modal-textarea" rows="3" placeholder="Note…"></textarea>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" id="qid-cancel">Annuler</button>
      <button type="button" class="btn btn-primary" id="qid-assign" disabled>Attribuer</button>
    </div>
  </div>
</div>

<style>
.action-bar       { display:flex; gap:8px; margin-bottom:24px; flex-wrap:wrap; }
.section-block    { margin-bottom:32px; }
.section-title    { font-family:var(--font-head); font-size:13px; color:var(--muted); letter-spacing:.1em; text-transform:uppercase; margin-bottom:12px; border-bottom:1px solid var(--border); padding-bottom:6px; }
.detail-grid-3    { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
.names-grid       { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:6px; }
.name-entry       { display:flex; gap:8px; align-items:baseline; font-size:13px; }
.name-lang        { font-size:10px; color:var(--muted); letter-spacing:.06em; width:36px; flex-shrink:0; }
.name-val         { color:var(--text); }
.track-block      { margin-bottom:20px; }
.track-title      { font-size:12px; font-weight:600; color:var(--accent2); letter-spacing:.08em; margin-bottom:6px; }
.data-table--compact td, .data-table--compact th { padding:5px 8px; font-size:12px; }
.cell-notes       { font-size:11px; max-width:300px; }

/* Track colour cues — same hues as the gaps view, for continuity */
.track-title--religion { color:#d8b4fe; }
.track-title--language { color:#fdba74; }
.track-title--polity   { color:#93c5fd; }
.track-title--culture  { color:#86efac; }

.tag--religion { background:color-mix(in srgb,#a855f7 20%,transparent); color:#d8b4fe; }
.tag--language { background:color-mix(in srgb,#f97316 20%,transparent); color:#fdba74; }
.tag--polity   { background:color-mix(in srgb,#3b82f6 20%,transparent); color:#93c5fd; }
.tag--culture  { background:color-mix(in srgb,#22c55e 20%,transparent); color:#86efac; }

/* Role qualifiers: weight reflects prominence */
.role-badge          { font-size:10px; padding:1px 6px; border-radius:2px; letter-spacing:.04em; }
.role-badge--state    { background:rgba(201,168,76,.22); color:var(--accent,#c9a84c); font-weight:600; }
.role-badge--major    { background:rgba(126,184,160,.18); color:#7eb8a0; }
.role-badge--minor    { background:rgba(127,127,127,.15); color:var(--muted); }
.role-badge--minority { background:rgba(127,127,127,.10); color:var(--muted); font-style:italic; }

.conf-badge       { font-size:10px; padding:1px 5px; border-radius:2px; }
.conf-badge--high   { background:rgba(90,154,106,.15); color:#7eb8a0; }
.conf-badge--medium { background:rgba(201,168,76,.15); color:var(--accent); }
.conf-badge--low    { background:rgba(192,112,96,.15); color:#c07060; }

.wd-id            { font-size:10px; color:var(--muted); text-decoration:none; border-bottom:1px dotted var(--border); }
.wd-id:hover      { color:var(--accent2); }
.no-qid           { font-size:10px; color:#c07060; opacity:.7; }
.hiatus           { color:#c07060; }

/* .badge--level / .badge--{indexed,queued,extracted,excluded} moved to the
   shared admin.css — /admin/sites list uses the same badge and needs the
   rule too. Do not redefine here. */

.hint             { font-size:11px; color:var(--muted); margin-top:8px; }
.json-pre         { background:var(--bg); padding:14px; border-radius:2px; font-size:11px; font-family:'JetBrains Mono',monospace; overflow-x:auto; color:var(--muted); border:1px solid var(--border); max-height:400px; overflow-y:auto; }

/* ── Timeline editing ── */
.col-act          { width:28px; text-align:center; }
.entry-del        { background:transparent; border:1px solid transparent; color:var(--muted); cursor:pointer; font-size:12px; line-height:1; padding:2px 5px; border-radius:3px; opacity:.5; }
.entry-del:hover  { opacity:1; color:#e06a5a; border-color:rgba(224,106,90,.4); }
.qid-edit         { cursor:pointer; border-bottom:1px dashed transparent; }
.qid-edit:hover   { border-bottom-color:var(--accent2); }
.qid-edit--empty  { }
.qid-edit--empty:hover { background:color-mix(in srgb,#c07060 12%,transparent); border-radius:2px; }

/* ── Modal ── */
.modal-overlay    { position:fixed; inset:0; background:rgba(0,0,0,.55); display:flex; align-items:flex-start; justify-content:center; padding-top:8vh; z-index:1000; }
.modal-overlay[hidden] { display:none; }
.modal            { background:var(--bg,#111); border:1px solid var(--border); border-radius:6px; width:min(560px,92vw); max-height:80vh; display:flex; flex-direction:column; box-shadow:0 12px 40px rgba(0,0,0,.5); }
.modal-head       { display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border-bottom:1px solid var(--border); font-size:13px; font-weight:600; }
.modal-close      { background:transparent; border:none; color:var(--muted); cursor:pointer; font-size:15px; }
.modal-close:hover { color:var(--text); }
.modal-body       { padding:14px 16px; overflow-y:auto; }
.modal-current    { font-size:12px; color:var(--muted); margin-bottom:12px; padding:8px 10px; background:var(--bg2,rgba(127,127,127,.06)); border-radius:4px; }
.modal-current .cur-name { color:var(--text); font-weight:600; }
.modal-label      { display:block; font-size:10px; text-transform:uppercase; letter-spacing:.07em; color:var(--muted); margin:12px 0 4px; }
.modal-input      { width:100%; box-sizing:border-box; padding:7px 9px; font-size:13px; font-family:inherit; background:var(--surface,transparent); color:var(--text); border:1px solid var(--border); border-radius:3px; }
.modal-input:focus { outline:none; border-color:var(--accent2); }
.modal-results    { margin-top:4px; border:1px solid var(--border); border-radius:3px; max-height:190px; overflow-y:auto; display:none; }
.modal-results.show { display:block; }
.mr-hit           { padding:6px 9px; font-size:12px; border-bottom:1px solid var(--border); display:flex; align-items:baseline; gap:8px; }
.mr-hit:last-child { border-bottom:none; }
.mr-hit-label     { font-weight:600; }
.mr-hit-kind      { font-size:10px; padding:0 5px; border:1px solid var(--border); border-radius:3px; color:var(--muted); }
.mr-hit-desc      { color:var(--muted); font-size:11px; flex:1; }
.mr-hit-pick      { margin-left:auto; font-size:11px; padding:2px 8px; background:transparent; border:1px solid var(--border); color:var(--muted); border-radius:3px; cursor:pointer; }
.mr-hit-pick:hover { color:var(--text); border-color:var(--text); }
.modal-selected   { margin-top:12px; font-size:12px; color:var(--text); padding:8px 10px; background:color-mix(in srgb,#6366f1 12%,transparent); border-radius:4px; }
.lbl-row          { display:flex; gap:6px; align-items:center; }
.lbl-use          { flex:0 0 auto; font-size:11px; padding:3px 9px; background:transparent; border:1px solid var(--border); color:var(--muted); border-radius:3px; cursor:pointer; white-space:nowrap; }
.lbl-use:hover    { color:var(--text); border-color:var(--text); }
.modal-textarea   { resize:vertical; min-height:52px; font-family:inherit; line-height:1.4; }
.modal-context    { font-size:12px; color:var(--muted); margin-bottom:14px; padding:9px 11px; background:var(--bg2,rgba(127,127,127,.06)); border-radius:4px; line-height:1.5; }
.modal-context .ctx-type { display:inline-block; font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--bg,#111); background:var(--accent2,#8a7); padding:2px 9px; border-radius:3px; margin-right:8px; }
.modal-context .ctx-site { color:var(--text); font-weight:600; }
.modal-context .ctx-line { display:block; margin-top:4px; }
.modal-context .ctx-k { color:var(--muted); }
.date-grid        { display:grid; grid-template-columns:2fr 1fr; gap:12px; margin-top:4px; }
.date-row         { display:flex; gap:5px; align-items:center; }
.date-year        { width:100%; }
.date-prec        { flex:0 0 auto; width:auto; }
.date-circa       { display:flex; align-items:center; gap:3px; white-space:nowrap; color:var(--muted); font-size:13px; }
.add-entry        { margin-left:10px; font-size:11px; font-weight:400; padding:2px 9px; background:transparent; border:1px solid var(--border); color:var(--muted); border-radius:3px; cursor:pointer; vertical-align:middle; }
.add-entry:hover  { color:var(--text); border-color:var(--text); }
.track-empty      { font-size:12px; padding:4px 0 8px; }
.mr-hit-dates     { font-size:10px; color:var(--muted); font-variant-numeric:tabular-nums; margin-left:6px; white-space:nowrap; }
.modal-foot       { display:flex; justify-content:flex-end; gap:8px; padding:12px 16px; border-top:1px solid var(--border); }
</style>

<script>
function toggleJson() {
  var el = document.getElementById('json-raw');
  var icon = document.getElementById('json-toggle-icon');
  if (el.style.display === 'none') { el.style.display='block'; icon.textContent='▼'; }
  else { el.style.display='none'; icon.textContent='▶'; }
}

// ── Timeline editing ────────────────────────────────────────────────────────
(function () {
  // The server routes on /admin/sites/:id — the last path segment IS that id,
  // whatever column it maps to. Deriving it from the URL avoids any mismatch.
  var SITE_ID = decodeURIComponent(location.pathname.split('/').filter(Boolean).pop());
  var WD = 'https://www.wikidata.org/w/api.php';

  function debounce(fn, ms) { var t; return function () { var a = arguments, c = this; clearTimeout(t); t = setTimeout(function () { fn.apply(c, a); }, ms); }; }
  function esc(s) { return (s == null ? '' : String(s)).replace(/[&<>"]/g, function (m) { return ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' })[m]; }); }
  function wdLink(qid) { return '<a href="https://www.wikidata.org/wiki/' + qid + '" target="_blank" rel="noopener" class="wd-id">' + qid + ' ↗</a>'; }

  // ── Delete an entry ──
  document.addEventListener('click', function (ev) {
    var btn = ev.target.closest && ev.target.closest('.entry-del');
    if (!btn) return;
    var track = btn.dataset.track, index = btn.dataset.index, name = btn.dataset.name || '';
    if (!confirm('Supprimer cette entrée ?\n\n' + track + ' — ' + name)) return;
    btn.disabled = true;
    fetch('/admin/sites/' + encodeURIComponent(SITE_ID) + '/timeline/delete-entry', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ track: track, index: Number(index), expectedName: name }),
    }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) { if (!res.ok) throw new Error(res.d.error || 'Erreur serveur'); window.location.reload(); })
      .catch(function (e) { alert('Erreur : ' + e.message); btn.disabled = false; });
  });

  // ── Entry modal (edit + add) ──
  var SITE_TITLE = <%~ JSON.stringify(it.site.title_en || it.site.id || '') %>;
  var QID_TRACKS_JS = ['polity','culture','religion','language'];
  var ROLE_TRACKS_JS = ['religion','language'];

  var modal = document.getElementById('qid-modal');
  var elTitle = document.getElementById('qid-modal-title');
  var elContext = document.getElementById('qid-modal-context');
  var inOurs = document.getElementById('qid-search-ours');
  var inWd = document.getElementById('qid-search-wd');
  var resOurs = document.getElementById('qid-results-ours');
  var resWd = document.getElementById('qid-results-wd');
  var elSel = document.getElementById('qid-selected');
  var elSelVal = document.getElementById('qid-selected-val');
  var elLabelInput = document.getElementById('qid-label-input');
  var elLabelUse = document.getElementById('qid-label-use');
  var elNoteInput = document.getElementById('qid-note-input');
  var elFrom = document.getElementById('qid-from');
  var elFromPrec = document.getElementById('qid-from-prec');
  var elFromCirca = document.getElementById('qid-from-circa');
  var elTo = document.getElementById('qid-to');
  var elRoleWrap = document.getElementById('qid-role-wrap');
  var elRole = document.getElementById('qid-role');
  var btnAssign = document.getElementById('qid-assign');

  var editing = null;       // { mode, track, index, name, qid, notes, from, from_precision, from_circa, to, role }
  var selected = null;      // chosen QID
  var selectedLabel = null;

  function fmtY(y) { if (y == null || y === '') return null; y = Number(y); return y < 0 ? Math.abs(y) + ' BC' : y + ' AD'; }
  function fmtRange(from, to, circa) {
    var f = fmtY(from); if (f == null) return '—';
    return (circa ? '~' : '') + f + (to != null && to !== '' ? ' → ' + fmtY(to) : '');
  }

  function renderContext() {
    var html = '<span class="ctx-type">' + esc(editing.track) + '</span>';
    html += '<span class="ctx-site">' + esc(SITE_TITLE) + '</span>';
    if (editing.mode === 'add') {
      html += '<span class="ctx-line ctx-k">Nouvelle entrée</span>';
    } else {
      html += '<span class="ctx-line"><span class="ctx-k">Dates : </span>' + esc(fmtRange(editing.from, editing.to, editing.from_circa)) + '</span>';
      html += '<span class="ctx-line"><span class="ctx-k">Libellé : </span>' + esc(editing.name || '—') + (editing.qid ? ' (' + editing.qid + ')' : '') + '</span>';
      if (editing.notes) html += '<span class="ctx-line"><span class="ctx-k">Note : </span>' + esc(editing.notes) + '</span>';
    }
    elContext.innerHTML = html;
  }

  function updateSave() {
    if (!editing) { btnAssign.disabled = true; return; }
    if (editing.mode === 'add') {
      btnAssign.disabled = !(elLabelInput.value.trim() && elFrom.value.trim() !== '' && !isNaN(Number(elFrom.value)));
      return;
    }
    var labelChanged = elLabelInput.value.trim() !== (editing.name || '');
    var noteChanged = elNoteInput.value !== (editing.notes || '');
    var fromChanged = elFrom.value.trim() !== '' && Number(elFrom.value) !== editing.from;
    var precChanged = Number(elFromPrec.value) !== (editing.from_precision || 9);
    var circaChanged = elFromCirca.checked !== !!editing.from_circa;
    var toChanged = (elTo.value.trim() === '' ? null : Number(elTo.value)) !== (editing.to != null ? editing.to : null);
    var roleChanged = !elRoleWrap.hidden && elRole.value !== (editing.role || '');
    btnAssign.disabled = !(selected || labelChanged || noteChanged || fromChanged || precChanged || circaChanged || toChanged || roleChanged);
  }

  function setSelected(qid, label) {
    selected = /^Q\d+$/.test(qid) ? qid : null;
    selectedLabel = label || null;
    elSel.hidden = !selected;
    if (selected) elSelVal.innerHTML = wdLink(selected);
    if (selected && selectedLabel && selectedLabel !== elLabelInput.value.trim()) {
      elLabelUse.textContent = 'utiliser « ' + selectedLabel + ' »'; elLabelUse.hidden = false;
    } else { elLabelUse.hidden = true; }
    updateSave();
  }

  function pickBtn(qid, label) {
    return '<button type="button" class="mr-hit-pick" data-qid="' + qid + '" data-label="' + esc(label || '') + '">Choisir</button>';
  }

  function setupRole() { elRoleWrap.hidden = ROLE_TRACKS_JS.indexOf(editing.track) === -1; }

  function resetSearch() {
    resOurs.classList.remove('show'); resWd.classList.remove('show');
    resOurs.innerHTML = ''; resWd.innerHTML = '';
    elLabelUse.hidden = true; setSelected('');
  }

  function openEditModal(span) {
    editing = {
      mode: 'edit', track: span.dataset.track, index: Number(span.dataset.index),
      name: span.dataset.name || '', qid: span.dataset.qid || '', notes: span.dataset.notes || '',
      from: span.dataset.from !== '' ? Number(span.dataset.from) : null,
      from_precision: span.dataset.fromprec !== '' ? Number(span.dataset.fromprec) : null,
      from_circa: span.dataset.fromcirca === '1',
      to: span.dataset.to !== '' ? Number(span.dataset.to) : null,
      role: span.dataset.role || ''
    };
    elTitle.textContent = 'Éditer l\u2019entrée';
    elLabelInput.value = editing.name; elNoteInput.value = editing.notes;
    elFrom.value = editing.from != null ? editing.from : '';
    elFromPrec.value = String(editing.from_precision || 9);
    elFromCirca.checked = !!editing.from_circa;
    elTo.value = editing.to != null ? editing.to : '';
    setupRole(); elRole.value = editing.role || '';
    inOurs.value = editing.name; inWd.value = editing.name;
    resetSearch(); renderContext();
    btnAssign.textContent = 'Enregistrer';
    modal.hidden = false; runOurs(); runWd(); elLabelInput.focus();
  }

  function openAddModal(track) {
    editing = { mode: 'add', track: track, name: '', qid: '', notes: '', from: null, from_precision: null, from_circa: false, to: null, role: '' };
    elTitle.textContent = 'Ajouter une entrée';
    elLabelInput.value = ''; elNoteInput.value = '';
    elFrom.value = ''; elFromPrec.value = '9'; elFromCirca.checked = false; elTo.value = '';
    setupRole(); elRole.value = '';
    inOurs.value = ''; inWd.value = '';
    resetSearch(); renderContext();
    btnAssign.textContent = 'Ajouter';
    modal.hidden = false; runOurs(); runWd(); elLabelInput.focus();
  }

  function closeModal() { modal.hidden = true; editing = null; }

  var runOurs = debounce(function () {
    var q = inOurs.value.trim();
    if (q.length < 2 || !editing) { resOurs.classList.remove('show'); return; }
    fetch('/admin/gaps/search-entities?' + new URLSearchParams({ q: q, kind: editing.track }))
      .then(function (r) { return r.ok ? r.json() : { results: [] }; })
      .then(function (data) {
        var rows = data.results || [];
        if (!rows.length) { resOurs.innerHTML = '<div class="mr-hit"><span class="mr-hit-desc">Aucun résultat dans nos entities</span></div>'; resOurs.classList.add('show'); return; }
        resOurs.innerHTML = rows.map(function (e) {
          return '<div class="mr-hit"><span class="mr-hit-label">' + esc(e.label_en) + '</span>' +
                 '<span class="mr-hit-kind">' + esc(e.kind) + '</span>' + wdLink(e.qid) +
                 (e.dates ? '<span class="mr-hit-dates">' + esc(e.dates) + '</span>' : '') +
                 '<span class="mr-hit-desc">' + esc(e.description_en || '') + '</span>' + pickBtn(e.qid, e.label_en) + '</div>';
        }).join('');
        resOurs.classList.add('show');
      }).catch(function () { resOurs.classList.remove('show'); });
  }, 260);

  async function wdSearch(q) {
    var url = WD + '?' + new URLSearchParams({ action:'wbsearchentities', format:'json', language:'en', uselang:'en', type:'item', limit:'7', search:q, origin:'*' });
    var r = await fetch(url); if (!r.ok) return []; return (await r.json()).search || [];
  }

  var runWd = debounce(function () {
    var q = inWd.value.trim();
    if (q.length < 2 || !editing) { resWd.classList.remove('show'); return; }
    wdSearch(q).then(function (hits) {
      if (!hits.length) { resWd.classList.remove('show'); return; }
      resWd.innerHTML = hits.map(function (h) {
        return '<div class="mr-hit"><span class="mr-hit-label">' + esc(h.label || '') + '</span>' + wdLink(h.id) +
               '<span class="mr-hit-desc">' + esc(h.description || '') + '</span>' + pickBtn(h.id, h.label) + '</div>';
      }).join('');
      resWd.classList.add('show');
    }).catch(function () { resWd.classList.remove('show'); });
  }, 280);

  document.addEventListener('click', function (ev) {
    var span = ev.target.closest && ev.target.closest('.qid-edit');
    if (span) { ev.preventDefault(); openEditModal(span); return; }
    var add = ev.target.closest && ev.target.closest('.add-entry');
    if (add) { ev.preventDefault(); openAddModal(add.dataset.track); }
  });
  [resOurs, resWd].forEach(function (box) {
    box.addEventListener('click', function (ev) {
      var pick = ev.target.closest('.mr-hit-pick');
      if (pick) setSelected(pick.dataset.qid, pick.dataset.label);
    });
  });
  inOurs.addEventListener('input', runOurs);
  inWd.addEventListener('input', runWd);
  elLabelUse.addEventListener('click', function () {
    if (selectedLabel) { elLabelInput.value = selectedLabel; elLabelUse.hidden = true; updateSave(); }
  });
  elLabelInput.addEventListener('input', function () {
    if (!elLabelUse.hidden && selectedLabel && elLabelInput.value.trim() === selectedLabel) elLabelUse.hidden = true;
    updateSave();
  });
  elNoteInput.addEventListener('input', updateSave);
  elFrom.addEventListener('input', updateSave);
  elFromPrec.addEventListener('change', updateSave);
  elFromCirca.addEventListener('change', updateSave);
  elTo.addEventListener('input', updateSave);
  elRole.addEventListener('change', updateSave);
  document.getElementById('qid-modal-close').addEventListener('click', closeModal);
  document.getElementById('qid-cancel').addEventListener('click', closeModal);
  // Overlay close: only when the gesture BOTH starts and ends on the backdrop —
  // prevents an accidental close when selecting text in an input and releasing
  // outside it (the click target then resolves to the overlay).
  var downOnOverlay = false;
  modal.addEventListener('mousedown', function (ev) { downOnOverlay = (ev.target === modal); });
  modal.addEventListener('click', function (ev) { if (ev.target === modal && downOnOverlay) closeModal(); });
  document.addEventListener('keydown', function (ev) { if (ev.key === 'Escape' && !modal.hidden) closeModal(); });

  function collectDates(body) {
    if (elFrom.value.trim() !== '') body.from = Number(elFrom.value);
    body.from_precision = Number(elFromPrec.value);
    body.from_circa = elFromCirca.checked;
    body.to = elTo.value.trim() === '' ? null : Number(elTo.value);
    if (!elRoleWrap.hidden) body.role = elRole.value;
  }

  function post(path, body) {
    btnAssign.disabled = true; var prev = btnAssign.textContent; btnAssign.textContent = '…';
    fetch('/admin/sites/' + encodeURIComponent(SITE_ID) + path, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) { if (!res.ok) throw new Error(res.d.error || 'Erreur serveur'); window.location.reload(); })
      .catch(function (e) { alert('Erreur : ' + e.message); btnAssign.disabled = false; btnAssign.textContent = prev; });
  }

  btnAssign.addEventListener('click', function () {
    if (!editing) return;
    if (editing.mode === 'add') {
      var name = elLabelInput.value.trim();
      if (!name || elFrom.value.trim() === '' || isNaN(Number(elFrom.value))) return;
      var addBody = { track: editing.track, name: name };
      if (selected) addBody.qid = selected;
      if (elNoteInput.value.trim()) addBody.notes = elNoteInput.value;
      collectDates(addBody);
      post('/timeline/add-entry', addBody);
      return;
    }
    var body = { track: editing.track, index: editing.index, expectedName: editing.name };
    if (selected) body.qid = selected;
    if (elLabelInput.value.trim() !== (editing.name || '')) body.newName = elLabelInput.value.trim();
    if (elNoteInput.value !== (editing.notes || '')) body.notes = elNoteInput.value;
    collectDates(body);
    post('/timeline/set-qid', body);
  });
})();
</script>
